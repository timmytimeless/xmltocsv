<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Timeless.DataConversion</RootNamespace>
    <AssemblyName>Timeless.DataConversion</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>true</IsPackable>
    <PackageId>Timeless.DataConversion</PackageId>
    <Version>3.3.0</Version>
    <Authors>Timeless</Authors>
    <Company>Timeless</Company>
    <Description>Convert XML into one or more CSV files with streaming previews, nested table inference, relationship columns, validation, and configurable safety limits.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.tidelose.com/converter/xmltocsv</PackageProjectUrl>
    <RepositoryUrl>https://github.com/timmytimeless/xmltocsv</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>xml;csv;xml-to-csv;conversion;converter;data-conversion</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
